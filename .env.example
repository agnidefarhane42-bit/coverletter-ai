# ==========================================
# CoverLetter AI - Environment Variables
# ==========================================

# General
NODE_ENV=development

# ------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# Mistral AI API Key (Required for AI generation)
MISTRAL_API_KEY=your_mistral_api_key_here

# DocEngine API Key (Required for PDF/DOCX export)
DOCENGINE_API_KEY=your_docengine_api_key_here

# Notch Pay Keys (Required for payments & subscriptions)
NOTCH_PAY_PUBLIC_KEY=sb.pub_xxxxxxxxxxxxxxxxxxxxxxxx
NOTCH_PAY_PRIVATE_KEY=sb.prv_xxxxxxxxxxxxxxxxxxxxxxxx

# ------------------------------------------
# Frontend Configuration (Next.js 15)
# ------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_NOTCH_PAY_PUBLIC_KEY=sb.pub_xxxxxxxxxxxxxxxxxxxxxxxx
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_key_here
